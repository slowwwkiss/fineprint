# Copy to `.env` and fill in from the Firebase console (see SETUP.md).
# NEVER commit a filled-in `.env` — it is gitignored for a reason.
# The Firebase *web* apiKey is a public client identifier, not a secret;
# real security comes from App Check + Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA v3 site key for App Check (Firebase console > App Check).
# Leave empty for local demo mode (on-device still works; cloud refuses
# politely until a real project + site key are supplied).
VITE_APPCHECK_SITE_KEY=
